# Copy this file to .env.local and fill in real values.
# Never commit .env.local — it is gitignored.

# --- Anthropic API (Scholar's model layer) ---
# Create a key at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...
# Week 3 introduces the model policy in lib/llm/; this is the fallback default.
ANTHROPIC_DEFAULT_MODEL=claude-sonnet-5

# --- OpenRouter (second provider) ---
# Used for the Week 9 cross-family eval A/B and as a fallback path. Optional until then.
OPENROUTER_API_KEY=
OPENROUTER_COMPARISON_MODEL=

# --- Supabase (auth, database, storage, realtime) ---
# From your Supabase project settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Server-only, never expose to the client. Bypasses row-level security.
SUPABASE_SERVICE_ROLE_KEY=eyJ...
# Local Supabase (via `supabase start`) — used in dev and tests
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- Vercel (deployment, analytics) ---
# Injected automatically in production; needed for local sync
VERCEL_URL=

# --- Stripe (billing — introduced in Week 13) ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# --- Observability (introduced in Week 11) ---
# Sentry for app errors
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
# Langfuse for model tracing
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Log level: debug | info | warn | error
LOG_LEVEL=info
