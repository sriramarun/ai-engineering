# Copy this file to .env.local and fill in real values.
# Never commit .env.local — it is gitignored.

# --- OpenRouter (LLM access) ---
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...
# Default model. Post 03 introduces the model router; this is the fallback default.
OPENROUTER_DEFAULT_MODEL=anthropic/claude-sonnet-5
# Optional: comma-separated fallback chain used by the model router
OPENROUTER_FALLBACK_MODELS=openai/gpt-5,google/gemini-2.5-pro

# --- Supabase (auth, database, storage, realtime) ---
# From your Supabase project settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Server-only, never expose to the client
SUPABASE_SERVICE_ROLE_KEY=eyJ...
# Local Supabase (via `supabase start`) — used in tests and dev
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- Vercel (deployment, analytics) ---
# Injected automatically in production; needed for local sync
VERCEL_URL=

# --- Stripe (billing — introduced in Post 12) ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# --- Observability (introduced in Post 09) ---
# Sentry for app errors
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
# Langfuse for LLM tracing
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- App ---
# Public base URL of the deployed app (used in redirects, emails)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Log level: debug | info | warn | error
LOG_LEVEL=info
